{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "app",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
